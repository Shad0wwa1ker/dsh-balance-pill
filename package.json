{
  "name": "@local/dsh-balance-pill",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Composer pill showing the DeepSeek account balance, the current peak/off-peak phase, and this session's estimated spend.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shad0wwa1ker/dsh-balance-pill.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "balance",
    "pricing"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
